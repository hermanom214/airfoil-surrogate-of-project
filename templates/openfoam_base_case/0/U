FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (20.000000 0.000000 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (20.000000 0.000000 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    top
    {
        type            slip;
    }

    bottom
    {
        type            slip;
    }

    airfoil_main
    {
        type            fixedValue;
		value			uniform (0 0 0);
    }
	
	airfoil_TE
    {
        type            fixedValue;
		value			uniform (0 0 0);
    }
	
	front
	{
		type			symmetryPlane;
	}
	
	back
	{
		type			symmetryPlane;
	}
	
}

