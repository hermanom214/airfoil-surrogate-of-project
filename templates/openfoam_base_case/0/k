FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.06;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.06;
    }
    outlet
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    bottom
    {
        type            zeroGradient;
    }
    airfoil_main
    {
		type kqRWallFunction;
		value uniform 1e-6;
    }
	airfoil_TE
    {
		type kqRWallFunction;
		value uniform 1e-6;
    }
	front
	{
		type			symmetryPlane;
	}
	back
	{
		type			symmetryPlane;
	}
}


