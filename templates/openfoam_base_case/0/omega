FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 6.4;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 6.4;
    }
    outlet
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    bottom
    {
        type            zeroGradient;
    }
    airfoil
    {
        type            omegaWallFunction;
        value           uniform 10;
    }
	front
	{
		type			symmetryPlane;
	}
	back
	{
		type			symmetryPlane;
	}
}


