FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    airfoil.stl
    {
        type triSurfaceMesh;
        name airfoil;

        regions
        {
            airfoil_main
            {
                name airfoil_main;
            }

            airfoil_TE
            {
                name airfoil_TE;
            }
        }
    }
	
	refinementBoxAirfoil
	{
		type searchableBox;
		min (-0.05 -0.12 -0.06);
		max (1.05  0.12  0.06);
	}
	
	trailingEdgeBox
	{
		type searchableBox;
		min (0.93 -0.04 -0.06);
		max (1.04  0.04  0.06);
	}
	
	trailingEdgeSmallBox
	{
		type searchableBox;
		min (0.98 -0.03 -0.06);
		max (1.02  0.03  0.06);
	}
}

castellatedMeshControls
{
    maxLocalCells 100000;
    maxGlobalCells 2000000;
    minRefinementCells 10;
    nCellsBetweenLevels 4;

    features
    (
        {
            file "airfoil.eMesh";
            level 6;
        }
    );

	refinementSurfaces
	{
    airfoil
    {
        level (4 5);

        patchInfo
        {
            type wall;
        }

        regions
        {
            airfoil_main
            {
                level (4 5);
                patchInfo
                {
                    type wall;
                }
            }

            airfoil_TE
            {
                level (5 6);
                patchInfo
                {
                    type wall;
                }
            }
        }
    }
	}

    resolveFeatureAngle 30;

    refinementRegions
    {
	    
		refinementBoxAirfoil
		{
			mode inside;
			//levels ((1E15 3));
			levels ((1E15 2));
		}
		
		trailingEdgeBox
		{
			mode inside;
			//levels ((1E15 3));
			levels ((1E15 4));
		}
		
		trailingEdgeSmallBox
		{
			mode inside;
			//levels ((1E15 4));
			levels ((1E15 5));
		}
    }

    locationInMesh (2 0 0);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 10;
    tolerance 2.0;
	//tolerance 1.2;
    nSolveIter 100;
    nRelaxIter 10;
    nFeatureSnapIter 20;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;

	layers
    {
        airfoil_main
        {
            nSurfaceLayers 0;
        }

        airfoil_TE
        {
            nSurfaceLayers 0;
        }
    }

    expansionRatio              1.2;
    finalLayerThickness         0.1;
    minThickness                0.05;

    nGrow                       3;

    featureAngle                60;
    slipFeatureAngle            30;

    nRelaxIter                  8;
    nSmoothSurfaceNormals       5;
    nSmoothNormals              5;
    nSmoothThickness            20;

    maxFaceThicknessRatio       0.35;
    maxThicknessToMedialRatio   0.25;
    minMedianAxisAngle          70;

    nBufferCellsNoExtrude       4;

    nLayerIter                  80;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality 1e-9;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.02;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);

mergeTolerance 1e-6;