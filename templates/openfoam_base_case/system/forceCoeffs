FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      forceCoeffs;
}

type            forceCoeffs;
functionObjectLibs ("libforces.so");

writeControl    timeStep;
writeInterval   1;

patches         (airfoil);

rhoInf          1.225;

liftDir         (0 1 0);
dragDir         (1 0 0);
pitchAxis       (0 0 1);

magUInf         20;

lRef            1.0;
Aref            1.0;

CofR            (0 0 0);