FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

//internalField   uniform 0.06;
internalField   uniform 0.005;

boundaryField
{
    inlet
    {
        type            fixedValue;
        //value           uniform 0.06;
		value           uniform 0.005;
    }
    outlet
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    bottom
    {
        type            zeroGradient;
    }
	farfield
    {
        type            zeroGradient;
    }
    airfoil
    {
		//type kqRWallFunction;
		//value uniform 1e-6;
		type fixedValue;
		value uniform 1e-10;
    }

	frontAndBack
	{
		type			empty;
	}
}


